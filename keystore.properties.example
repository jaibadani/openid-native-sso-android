# ==============================================================================
# Keystore Configuration for MOSIP Decode 03 Native SSO Apps
# Copy this file to 'keystore.properties' in the root project directory.
#
# Create the PKCS12 keystore using keytool before building release APKs:
#   mkdir -p ../keystore
#   keytool -genkeypair -v -keystore ../keystore/sso-team.p12 -storetype PKCS12 \
#     -alias sso-team-key -alg EC -keysize 256 -validity 10000 \
#     -dname "CN=MOSIP Native SSO Team, OU=Engineering, O=MOSIP, L=Bengaluru, ST=KA, C=IN"
# ==============================================================================

storeFile=../keystore/sso-team.p12
storePassword=ChangeThisStorePassword123!
keyAlias=sso-team-key
keyPassword=ChangeThisStorePassword123!
