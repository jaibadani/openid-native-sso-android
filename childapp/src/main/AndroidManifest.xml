<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Signature permission declared by Super App -->
    <uses-permission android:name="com.decode03.sso.permission.ACCESS_NATIVE_SSO" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Android 11+ Package Visibility query for Super App IPC binding -->
    <queries>
        <package android:name="com.decode03.superapp" />
        <intent>
            <action android:name="com.decode03.sso.action.BIND_SSO_SIGNING_SERVICE" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="@string/childapp_name"
        android:roundIcon="@android:drawable/sym_def_app_icon"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.Decode03ChildApp">

        <!-- Main Dashboard & Silent SSO Trigger Activity -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>

</manifest>
